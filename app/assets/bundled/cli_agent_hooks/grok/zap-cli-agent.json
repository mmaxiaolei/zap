{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/admin/.grok/hooks/zap-cli-agent/scripts/on-session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/admin/.grok/hooks/zap-cli-agent/scripts/on-prompt-submit.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/admin/.grok/hooks/zap-cli-agent/scripts/on-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/admin/.grok/hooks/zap-cli-agent/scripts/on-stop-failure.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt|task_complete",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/admin/.grok/hooks/zap-cli-agent/scripts/on-notification.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
